# Convex deployment this app talks to at runtime (safe to expose, it's just a URL).
# For local dev, `npx convex dev` fills this in automatically in .env.local.
# For a Vercel deployment, set this to your Convex *production* deployment URL
# (run `npx convex deploy` once to provision one, then copy the URL it prints).
NEXT_PUBLIC_CONVEX_URL=

# HTTP actions URL for the same deployment (used by Convex Auth). Also
# auto-filled locally by `npx convex dev`; for Vercel, use the URL printed
# alongside NEXT_PUBLIC_CONVEX_URL by `npx convex deploy`.
NEXT_PUBLIC_CONVEX_SITE_URL=

# --- Convex-side environment variables (set these via the Convex dashboard or
# `npx convex env set`, NOT here — they are never read by Next.js/Vercel) ---
# JWT_PRIVATE_KEY        RS256 private key Convex Auth signs session tokens with
# JWKS                   Matching public JWKS for verifying those tokens
# SITE_URL               Base URL of this app (used by Convex Auth callbacks)
# SMTP_USER / SMTP_PASS  Only needed if you enable the email-OTP second factor
#                        in Settings (off by default)
